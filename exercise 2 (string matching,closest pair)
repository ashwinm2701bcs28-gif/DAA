#include <iostream>
#include <string>
using namespace std;
void search(const string& text, const string& pattern) {
    int N = text.length();
    int M = pattern.length();
    bool found = false;

    // Outer loop to slide the pattern one by one across the text
    for (int i = 0; i <= N - M; i++) {
        // Print the current pass information
        cout << "Pass " << (i + 1) << ": Comparing pattern with text starting at index " << i << endl;
        cout << "   Text:    " << text << endl;
        cout << "   Pattern: ";
        // Print leading spaces to align the pattern with the current text position
        for (int k = 0; k < i; k++) {
            cout << " ";
        }
        cout << pattern << endl;

        int j;
        // Inner loop to check for pattern match at the current position i
        for (j = 0; j < M; j++) {
            if (text[i + j] != pattern[j]) {
                cout << "   Mismatch found at text index " << i + j << endl;
                break;
            }
        }

        // If the inner loop completed without a break, a match is found
        if (j == M) {
            cout << ">>> Pattern found at index " << i << " <<<" << endl;
            found = true;
        }
        cout << "----------------------------------------" << endl;
    }

    // Print the final result
    cout << "\n--- Final Result ---" << endl;
    cout << "Text:    " << text << endl;
    cout << "Pattern: " << pattern << endl;
    if (found) {
        cout << "The pattern string was found in the text." << endl;
    } else {
        cout << "The pattern string was not found in the text." << endl;
    }
}

int main() {
    string text, pattern;

    cout << "Enter the main text string: ";
    getline(cin, text); // Use getline to allow spaces in the text

    cout << "Enter the pattern string to search: ";
    getline(cin, pattern); // Use getline to allow spaces in the pattern

    if (pattern.length() > text.length()) {
        cout << "\nError: Pattern length cannot be greater than text length." << endl;
    } else {
        search(text, pattern);
    }

    return 0;
}

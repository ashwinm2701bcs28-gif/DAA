#include <iostream>
#include <vector>
#include <cmath>

using namespace std;

class NQueens {
public:
    vector<int> x;
    int n;

    // Check if a queen can be placed at Row k, Column i
    bool place(int k, int i) {
        for (int j = 1; j < k; j++) {
            if (x[j] == i || abs(x[j] - i) == abs(j - k)) {
                cout << "Cannot place at Row " << k << " Column " << i << endl;
                return false;
            }
        }
        cout << "Can place at Row " << k << " Column " << i << endl;
        return true;
    }

    // Recursive function to solve N-Queens
    void nQueens(int k) {
        for (int i = 1; i <= n; i++) {
            cout << "\nTrying Row " << k << " Column " << i << endl;

            if (place(k, i)) {
                x[k] = i;
                printBoard(k);
                if (k == n) {
                    printSolution();
                } else {
                    nQueens(k + 1);
                }
            }
        }
    }

    // Prints the board state during intermediate steps
    void printBoard(int uptoRow) {
        cout << "\nBoard after placing up to row " << uptoRow << ":" << endl;

        for (int i = 1; i <= n; i++) cout << "+---";
        cout << "+" << endl;

        for (int i = 1; i <= n; i++) {
            for (int j = 1; j <= n; j++) {
                if (i <= uptoRow && x[i] == j)
                    cout << "| Q ";
                else
                    cout << "|   ";
            }
            cout << "|" << endl;

            for (int j = 1; j <= n; j++) cout << "+---";
            cout << "+" << endl;
        }
    }

    // Prints the final completed solution
    void printSolution() {
        cout << "\nsolution:" << endl;

        cout << "Positions: ";
        for (int i = 1; i <= n; i++) {
            cout << x[i] << " ";
        }

        cout << "\nFinal Board:" << endl;
        for (int i = 1; i <= n; i++) cout << "+---";
        cout << "+" << endl;

        for (int i = 1; i <= n; i++) {
            for (int j = 1; j <= n; j++) {
                if (x[i] == j)
                    cout << "| Q ";
                else
                    cout << "|   ";
            }
            cout << "|" << endl;

            for (int j = 1; j <= n; j++) cout << "+---";
            cout << "+" << endl;
        }
    }
};

int main() {
    int n;
    cout << "Enter number of queens: ";
    cin >> n;

    NQueens obj;
    obj.n = n;
    // Resize vector to n + 1 to support your 1-based indexing
    obj.x.resize(n + 1);

    obj.nQueens(1);

    return 0;
}

